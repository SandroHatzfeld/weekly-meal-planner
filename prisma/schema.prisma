// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/**
 * User & Plan
 */

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  activePlanId String?
  createdAt    DateTime     @default(now())
  memberships  PlanMember[]
  recipes      Recipe[]
  apiTokens    ApiToken[]
  activePlan   Plan?        @relation(fields: [activePlanId], references: [id], onDelete: SetNull)
}

model Plan {
  id             String        @id @default(cuid())
  name           String
  members        PlanMember[]
  invites        PlanInvite[]
  dishes         Dish[]
  activeForUsers User[]
  groceryItems   GroceryItem[]
}

model PlanMember {
  userId   String
  planId   String
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([userId, planId])
}

enum Role {
  OWNER
  MEMBER
}

/**
 * Invites
 */

model PlanInvite {
  id        String       @id @default(cuid())
  planId    String
  type      InviteType
  email     String? // nur bei PERSONAL gesetzt
  token     String       @unique
  status    InviteStatus @default(PENDING)
  expiresAt DateTime
  invitedBy String
  createdAt DateTime     @default(now())
  plan      Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
}

enum InviteType {
  PERSONAL
  GENERIC
}

enum InviteStatus {
  PENDING // aktiv nutzbar
  ACCEPTED // nur PERSONAL: verbraucht
  REVOKED // nur GENERIC: durch Neu-Generieren ersetzt
  EXPIRED
}

/**
 * Recipes, Dishes & Grocerys
 */

model Recipe {
  id          String             @id @default(cuid())
  userId      String
  name        String
  description String?
  imageUrl    String?
  steps       String[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]
  dishes      Dish[] // nur Traceability, kein Live-Sync
}

model RecipeIngredient {
  id       String  @id @default(cuid())
  recipeId String
  name     String
  amount   Float?
  unit     String?
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Dish {
  id             String        @id @default(cuid())
  planId         String
  sourceRecipeId String? // Traceability: "Original ansehen/nochmal kochen"
  name           String
  description    String?
  imageUrl       String?
  steps          String[]      @default([])
  date           DateTime
  plan           Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  sourceRecipe   Recipe?       @relation(fields: [sourceRecipeId], references: [id], onDelete: SetNull)
  groceryItems   GroceryItem[]
}

model GroceryItem {
  id        String    @id @default(cuid())
  planId    String
  dishId    String? // NULL = "Unkategorisiert", wie in v2
  name      String
  details   String?
  checked   Boolean   @default(false)
  checkedAt DateTime?
  createdAt DateTime  @default(now())
  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  dish      Dish?     @relation(fields: [dishId], references: [id], onDelete: SetNull)
}

/**
 * ApiToken
 */

model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String // z.B. "Home Assistant"
  tokenHash  String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
