// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  previewFeatures = ["partialIndexes"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * User & Plan
 */

model User {
  id                 String                   @id @default(cuid())
  email              String                   @unique
  passwordHash       String
  name               String
  activePlanId       String?
  emailVerified      DateTime?
  createdAt          DateTime                 @default(now())
  memberships        PlanMember[]
  verificationTokens EmailVerificationToken[]
  recipes            Recipe[]
  apiTokens          ApiToken[]
  activePlan         Plan?                    @relation(fields: [activePlanId], references: [id], onDelete: SetNull)
}

model Plan {
  id             String        @id @default(cuid())
  name           String
  members        PlanMember[]
  invites        PlanInvite[]
  dishes         Dish[]
  activeForUsers User[]
  groceryLists   GroceryList[] @relation("PlanGroceryLists")
  tags           PlanTag[]
  // Liste für Zutaten beim Planen; NULL = erste Liste des Plans
  defaultListId  String?
  defaultList    GroceryList?  @relation("PlanDefaultList", fields: [defaultListId], references: [id], onDelete: SetNull)
}

model PlanMember {
  userId   String
  planId   String
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([userId, planId])
}

enum Role {
  OWNER
  MEMBER
}

/**
 * Invites
 */

model PlanInvite {
  id        String       @id @default(cuid())
  planId    String
  type      InviteType
  email     String? // nur bei PERSONAL gesetzt
  token     String       @unique
  status    InviteStatus @default(PENDING)
  expiresAt DateTime
  invitedBy String
  createdAt DateTime     @default(now())
  plan      Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)

  // pro Plan maximal ein aktiver Generic-Invite
  @@unique([planId], where: raw("type = 'GENERIC' AND status = 'PENDING'"))
}

enum InviteType {
  PERSONAL
  GENERIC
}

enum InviteStatus {
  PENDING // aktiv nutzbar
  ACCEPTED // nur PERSONAL: verbraucht
  REVOKED // nur GENERIC: durch Neu-Generieren ersetzt
  EXPIRED
}

/**
 * Recipes, Dishes & Grocerys
 */

model Recipe {
  id          String             @id @default(cuid())
  userId      String
  name        String
  description String?
  imageUrl    String?
  steps       String[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]
  dishes      Dish[] // nur Traceability, kein Live-Sync
}

model RecipeIngredient {
  id       String  @id @default(cuid())
  recipeId String
  name     String
  amount   Float?
  unit     String?
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Dish {
  id             String        @id @default(cuid())
  planId         String
  sourceRecipeId String? // Traceability: "Original ansehen/nochmal kochen"
  name           String
  description    String?
  imageUrl       String?
  steps          String[]      @default([])
  date           DateTime
  updatedAt      DateTime      @updatedAt // Optimistic Locking
  plan           Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  sourceRecipe   Recipe?       @relation(fields: [sourceRecipeId], references: [id], onDelete: SetNull)
  groceryItems   GroceryItem[]
}

model GroceryList {
  id             String                  @id @default(cuid())
  planId         String
  name           String
  createdAt      DateTime                @default(now())
  plan           Plan                    @relation("PlanGroceryLists", fields: [planId], references: [id], onDelete: Cascade)
  items          GroceryItem[]
  defaultOf      Plan[]                  @relation("PlanDefaultList")
  categories     GroceryCategory[]
  categoryMemory GroceryCategoryMemory[]
}

model GroceryItem {
  id         String           @id @default(cuid())
  listId     String
  dishId     String?
  name       String
  details    String?
  checked    Boolean          @default(false)
  checkedAt  DateTime?
  createdAt  DateTime         @default(now())
  list       GroceryList      @relation(fields: [listId], references: [id], onDelete: Cascade)
  dish       Dish?            @relation(fields: [dishId], references: [id], onDelete: SetNull)
  tags       PlanTag[]
  categoryId String?
  category   GroceryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

// frei einstellbare Tags pro Plan (z.B. Aktion, Angebot, App), mehrere pro GroceryItem
model PlanTag {
  id        String        @id @default(cuid())
  planId    String
  name      String
  icon      String // Schlüssel aus src/lib/tags/icons.ts
  createdAt DateTime      @default(now())
  plan      Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  items     GroceryItem[]
}

/**
 * ApiToken
 */

model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String // z.B. "Home Assistant"
  tokenHash  String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * E-Mail-Verifizierung
 */

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * Kategorien pro Einkaufsliste (Reihenfolge im Laden) + gelernte Zuordnung Produkt -> Kategorie
 */

model GroceryCategory {
  id       String                  @id @default(cuid())
  listId   String
  name     String // z.B. "Obst & Gemüse"
  position Int // Reihenfolge im Laden
  list     GroceryList             @relation(fields: [listId], references: [id], onDelete: Cascade)
  items    GroceryItem[]
  memory   GroceryCategoryMemory[]

  @@index([listId, position])
}

// pro Liste: zuletzt verwendete Schreibweise und Kategorie eines Produkts (für Vorschläge und automatisches Einsortieren)
model GroceryCategoryMemory {
  listId      String
  name        String // normalisiert, siehe normalizeItemName()
  displayName String
  categoryId  String?
  usedAt      DateTime         @default(now())
  list        GroceryList      @relation(fields: [listId], references: [id], onDelete: Cascade)
  category    GroceryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@id([listId, name])
}
