# Lokale Entwicklung: Verbindung zur Dev-DB
# (in docker-compose wird DATABASE_URL aus den POSTGRES_*-Variablen zusammengesetzt)
DATABASE_URL="postgresql://postgres:devpass@localhost:5432/bringplanner_dev"

# `npx auth secret` – signiert auch die Socket.io-Tickets
AUTH_SECRET=XXXX

# öffentliche URL der App, wird für Links in E-Mails verwendet
APP_URL=http://localhost:3000

# E-Mail-Versand über Resend. Ohne Key werden Mails nur in die Konsole geloggt.
RESEND_API_KEY=XXXX
MAIL_FROM="Weekly Meal Planner <noreply@example.com>"

# Rezept-Import von Links: Sprachmodell mit OpenAI-kompatibler Schnittstelle (OpenAI, OpenRouter, Ollama, …).
# Ohne LLM_BASE_URL und LLM_MODEL wird der Import-Bereich bei neuen Rezepten nicht angezeigt.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=XXXX

# Speicherort für Bilder (Standard: data/uploads, in Docker als Volume gemountet)
# UPLOAD_DIR=data/uploads

# nur für docker-compose
POSTGRES_DB=mealplanner
POSTGRES_USER=mealplanner
POSTGRES_PASSWORD=XXXX
APP_PORT=3010
